---
import CommonSectionWrapper from "./CommonSectionWrapper.astro";
import ContactCards from "./ContactCards.tsx";

const mapEmbedSrc =
  "https://www.google.com/maps?q=Rua+Bernardino+de+Campos+1221+Bairro+Alto+Piracicaba+SP&output=embed";
---

<CommonSectionWrapper
  id="contato"
  class="relative overflow-hidden bg-[#f5eeea]"
>
  <div
    class="pointer-events-none absolute -left-24 bottom-0 h-80 w-[320px] rounded-full bg-[#B79A82] opacity-[0.1] blur-3xl"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-3xl text-center">
    <span class="text-sm font-medium uppercase tracking-[0.2em] text-[#B79A82]">
      Fale comigo
    </span>
    <h2 class="mt-3 text-4xl leading-tight text-[#43261F] md:text-5xl">
      Vamos conversar sobre o seu próximo passo
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-lg text-[#43261F]/70">
      Escolha o canal que for mais fácil pra você, respondo rápido.
    </p>
  </div>

  <div
    class="relative mx-auto mt-14 grid max-w-5xl gap-8 md:grid-cols-2 md:items-stretch"
  >
    <ContactCards client:visible />

    <div
      class="relative min-h-80 overflow-hidden rounded-4xl bg-[#E4D0C5] md:min-h-0"
    >
      <iframe
        src={mapEmbedSrc}
        title="Localização do consultório da Dra. Luciana Tavares em Piracicaba/SP"
        class="h-full w-full min-h-80 border-0 filter-[grayscale(35%)_sepia(15%)_saturate(120%)]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</CommonSectionWrapper>
